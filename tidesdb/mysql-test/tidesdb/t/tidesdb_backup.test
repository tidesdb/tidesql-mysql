--source ../include/have_tidesdb.inc


# A failed backup logs before it raises, so the log check has to expect it.
CALL mtr.add_suppression("\\[TIDESDB\\] backup to .* failed");

--echo #
--echo # ============================================
--echo # TEST 1: Online backup creates a valid copy
--echo # ============================================
--echo #

CREATE TABLE t_backup (
  id INT PRIMARY KEY,
  val VARCHAR(100)
) ENGINE=TIDESDB;

INSERT INTO t_backup VALUES (1, 'alpha'), (2, 'beta'), (3, 'gamma');

# Verify data is present
SELECT * FROM t_backup ORDER BY id;

# Determine backup directory (inside the test's tmp dir)
--let $backup_dir= $MYSQLTEST_VARDIR/tmp/tidesdb_backup_test
--error 0,1
--force-rmdir $backup_dir

--echo # Taking the backup.  The function answers OK, so a failure fails this statement
--echo # rather than being left in the error log for someone to find.
--disable_query_log
eval SELECT tidesdb_backup('$backup_dir') AS backup;
--enable_query_log

--echo # Backup should have created the directory.  file_exists fails the test if it
--echo # is not there, rather than printing a NO that a recorded result would accept.
--file_exists $backup_dir

--echo # Insert more data after backup (should NOT appear in backup)
INSERT INTO t_backup VALUES (4, 'delta'), (5, 'epsilon');
SELECT COUNT(*) AS rows_after FROM t_backup;

DROP TABLE t_backup;

--echo #
--echo # ============================================
--echo # TEST 2: The destination must be absent or empty
--echo # ============================================
--echo #

--echo # TidesDB 10.2 refuses to write into a directory that already holds files, so a
--echo # second backup over the first one is rejected rather than half-overwriting it.
--disable_query_log
--replace_regex /backup to '.*' refused/backup to 'DESTINATION' refused/
--error ER_UNKNOWN_ERROR
eval SELECT tidesdb_backup('$backup_dir');
--enable_query_log

--echo # The first backup is still whole -- the refusal happened before anything was written.
--file_exists $backup_dir

--echo # An empty directory is a valid destination, it is only existing content that is refused.
--force-rmdir $backup_dir
--mkdir $backup_dir
--disable_query_log
eval SELECT tidesdb_backup('$backup_dir') AS backup_into_empty;
--enable_query_log
--echo # (succeeded -- the statement would have failed otherwise)

--echo #
--echo # ============================================
--echo # TEST 3: A backup with no destination is refused
--echo # ============================================
--echo #

--error ER_UNKNOWN_ERROR
SELECT tidesdb_backup('');
--echo # and the wrong argument shape is refused before anything runs
--error ER_CANT_INITIALIZE_UDF
SELECT tidesdb_backup();

--echo #
--echo # ============================================
--echo # TEST 4: Concurrent reads/writes during backup
--echo # ============================================
--echo #

CREATE TABLE t_concurrent (
  id INT PRIMARY KEY,
  data VARCHAR(200)
) ENGINE=TIDESDB;

# Load some data
--disable_query_log
--let $i= 1
while ($i <= 100)
{
  eval INSERT INTO t_concurrent VALUES ($i, REPEAT('x', 100));
  --inc $i
}
--enable_query_log

--echo # Inserted 100 rows
SELECT COUNT(*) AS before_backup FROM t_concurrent;

--let $backup_dir2= $MYSQLTEST_VARDIR/tmp/tidesdb_backup_concurrent
--error 0,1
--force-rmdir $backup_dir2

--disable_query_log
eval SELECT tidesdb_backup('$backup_dir2') AS backup;
--enable_query_log

--echo # Backup completed while table was loaded

# Verify the table is still fully readable after backup
SELECT COUNT(*) AS after_backup FROM t_concurrent;

# Verify writes still work after backup
INSERT INTO t_concurrent VALUES (101, 'post-backup');
SELECT COUNT(*) AS with_post_backup FROM t_concurrent;

DROP TABLE t_concurrent;

--echo #
--echo # ============================================
--echo # TEST 5: There is no per-table physical copy
--echo # ============================================
--echo #

--echo # FLUSH TABLES ... FOR EXPORT asks the engine to leave a set of files on
--echo # disk that can be copied out and read back as one table.  The store is one
--echo # flat directory with a database-wide manifest and value log, an sstable
--echo # holds whichever families flushed together, and the newest rows are in a
--echo # memtable shared by every table -- no subset of that is one table.  The
--echo # engine does not claim the capability, so the server refuses the statement
--echo # rather than accepting it and leaving an incomplete copy behind.

CREATE TABLE t_export (id INT PRIMARY KEY, val VARCHAR(50)) ENGINE=TIDESDB;
INSERT INTO t_export VALUES (1, 'a'), (2, 'b');

--error ER_ILLEGAL_HA
FLUSH TABLES t_export FOR EXPORT;

--echo # and the table is untouched by the refusal
SELECT id, val FROM t_export ORDER BY id;
DROP TABLE t_export;

--echo #
--echo # === Cleanup ===
--echo #

--error 0,1
--force-rmdir $backup_dir
--error 0,1
--force-rmdir $backup_dir2

--source ../include/cleanup_tidesdb.inc
--echo # Done.
