#
# ============================================
# TEST 1: Table-level TTL (short expiration)
# ============================================
#
CREATE TABLE t_ttl_table (
id INT PRIMARY KEY,
val VARCHAR(50)
) ENGINE=TIDESDB ENGINE_ATTRIBUTE='{"ttl": 8}';
INSERT INTO t_ttl_table VALUES (1, 'alpha'), (2, 'beta'), (3, 'gamma');
# Rows should be visible immediately
SELECT * FROM t_ttl_table ORDER BY id;
id	val
1	alpha
2	beta
3	gamma
# Wait for TTL to expire (3 seconds > 2 second TTL)
# Rows should now be expired (empty result)
SELECT * FROM t_ttl_table ORDER BY id;
id	val
DROP TABLE t_ttl_table;
#
# ============================================
# TEST 2: Per-row TTL via TTL_COL field option
# ============================================
#
CREATE TABLE t_ttl_col (
id INT PRIMARY KEY,
val VARCHAR(50),
expire_secs INT ENGINE_ATTRIBUTE='{"ttl": true}'
) ENGINE=TIDESDB;
INSERT INTO t_ttl_col VALUES (1, 'short', 8), (2, 'long', 86400), (3, 'forever', 0);
# All three rows visible immediately
SELECT id, val FROM t_ttl_col ORDER BY id;
id	val
1	short
2	long
3	forever
# Wait for the short TTL to expire
# Row 1 should be expired; rows 2 and 3 remain
SELECT id, val FROM t_ttl_col ORDER BY id;
id	val
2	long
3	forever
DROP TABLE t_ttl_col;
#
# ============================================
# TEST 3: Per-row TTL overrides table default
# ============================================
#
CREATE TABLE t_ttl_override (
id INT PRIMARY KEY,
val VARCHAR(50),
ttl_val INT ENGINE_ATTRIBUTE='{"ttl": true}'
) ENGINE=TIDESDB ENGINE_ATTRIBUTE='{"ttl": 86400}';
INSERT INTO t_ttl_override VALUES (1, 'short_override', 8), (2, 'uses_default', 0);
# Both rows visible immediately
SELECT id, val FROM t_ttl_override ORDER BY id;
id	val
1	short_override
2	uses_default
# Row 1 expired (per-row TTL=2 overrode default); row 2 still alive (table TTL=86400)
SELECT id, val FROM t_ttl_override ORDER BY id;
id	val
2	uses_default
DROP TABLE t_ttl_override;
#
# ============================================
# TEST 4: TTL=0 means no expiration (default)
# ============================================
#
CREATE TABLE t_ttl_none (
id INT PRIMARY KEY,
val VARCHAR(50)
) ENGINE=TIDESDB ENGINE_ATTRIBUTE='{"ttl": 0}';
INSERT INTO t_ttl_none VALUES (1, 'permanent');
# Row should still be present (TTL=0 = no expiration)
SELECT * FROM t_ttl_none ORDER BY id;
id	val
1	permanent
DROP TABLE t_ttl_none;
#
# ============================================
# TEST 5: TTL with UPDATE refreshes expiration
# ============================================
#
CREATE TABLE t_ttl_update (
id INT PRIMARY KEY,
val VARCHAR(50),
ttl_s INT ENGINE_ATTRIBUTE='{"ttl": true}'
) ENGINE=TIDESDB;
INSERT INTO t_ttl_update VALUES (1, 'original', 8);
# Row visible immediately
SELECT id, val FROM t_ttl_update ORDER BY id;
id	val
1	original
# UPDATE resets TTL to 5 more seconds
UPDATE t_ttl_update SET val = 'refreshed', ttl_s = 30 WHERE id = 1;
# Row should still be alive (UPDATE refreshed TTL at ~1s, now at ~3s, TTL=5s)
SELECT id, val FROM t_ttl_update ORDER BY id;
id	val
1	refreshed
DROP TABLE t_ttl_update;
#
# ============================================
# TEST 6: SHOW CREATE TABLE shows TTL options
# ============================================
#
CREATE TABLE t_ttl_show (
id INT PRIMARY KEY,
val VARCHAR(50),
row_ttl INT ENGINE_ATTRIBUTE='{"ttl": true}'
) ENGINE=TIDESDB ENGINE_ATTRIBUTE='{"ttl": 3600}';
SHOW CREATE TABLE t_ttl_show;
Table	Create Table
t_ttl_show	CREATE TABLE `t_ttl_show` (
  `id` int NOT NULL,
  `val` varchar(50) COLLATE utf8mb4_general_ci DEFAULT NULL,
  `row_ttl` int DEFAULT NULL /*!80021 ENGINE_ATTRIBUTE '{"ttl": true}' */,
  PRIMARY KEY (`id`)
) ENGINE=TidesDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci /*!80021 ENGINE_ATTRIBUTE='{"ttl": 3600}' */
DROP TABLE t_ttl_show;
#
# ============================================
# TEST 7: Session TTL override (SET SESSION)
#   Table has no TTL; session variable applies
# ============================================
#
CREATE TABLE t_ttl_sess (
id INT PRIMARY KEY,
val VARCHAR(50)
) ENGINE=TIDESDB;
# Default session TTL is 0 (no override)
SELECT @@session.tidesdb_ttl;
@@session.tidesdb_ttl
0
SET SESSION tidesdb_ttl = 8;
INSERT INTO t_ttl_sess VALUES (1, 'session_ttl'), (2, 'also_session');
# Rows visible immediately
SELECT * FROM t_ttl_sess ORDER BY id;
id	val
1	session_ttl
2	also_session
SET SESSION tidesdb_ttl = 0;
# Wait for session TTL to expire (3s > 2s)
# Rows should now be expired
SELECT * FROM t_ttl_sess ORDER BY id;
id	val
DROP TABLE t_ttl_sess;
#
# ============================================
# TEST 8: tidesdb_ttl set around a single statement
#   Only that statement's rows get a TTL
# ============================================
#
CREATE TABLE t_ttl_stmt (
id INT PRIMARY KEY,
val VARCHAR(50)
) ENGINE=TIDESDB;
SET SESSION tidesdb_ttl=8;
INSERT INTO t_ttl_stmt VALUES (1, 'short_lived');
SET SESSION tidesdb_ttl=0;
INSERT INTO t_ttl_stmt VALUES (2, 'permanent');
# Both rows visible immediately
SELECT * FROM t_ttl_stmt ORDER BY id;
id	val
1	short_lived
2	permanent
# Row 1 expired (session TTL=2); row 2 still alive (no TTL)
SELECT * FROM t_ttl_stmt ORDER BY id;
id	val
2	permanent
DROP TABLE t_ttl_stmt;
#
# ============================================
# TEST 9: Session TTL does NOT override per-row TTL_COL
# ============================================
#
CREATE TABLE t_ttl_priority (
id INT PRIMARY KEY,
val VARCHAR(50),
row_ttl INT ENGINE_ATTRIBUTE='{"ttl": true}'
) ENGINE=TIDESDB;
SET SESSION tidesdb_ttl = 86400;
INSERT INTO t_ttl_priority VALUES (1, 'per_row_wins', 8);
INSERT INTO t_ttl_priority VALUES (2, 'uses_session', 0);
SET SESSION tidesdb_ttl = 0;
# Both visible immediately
SELECT id, val FROM t_ttl_priority ORDER BY id;
id	val
1	per_row_wins
2	uses_session
# Row 1 expired (per-row TTL=2 wins); row 2 still alive (session TTL=86400)
SELECT id, val FROM t_ttl_priority ORDER BY id;
id	val
2	uses_session
DROP TABLE t_ttl_priority;
#
# ============================================
# TEST 10: UPDATE keeps an expiry no TTL source would name
# ============================================
#
# The table has no TTL of its own, so the only thing that set one was the session
# holding tidesdb_ttl at insert time.  A later UPDATE from a session with no TTL
# set has no source to compute from, and must carry the stored deadline forward
# rather than rewrite the row as permanent.
CREATE TABLE t_ttl_keep (id INT PRIMARY KEY, val VARCHAR(32)) ENGINE=TIDESDB;
SET SESSION tidesdb_ttl = 5;
INSERT INTO t_ttl_keep VALUES (1, 'updated'), (2, 'untouched');
SET SESSION tidesdb_ttl = 0;
# Row 1 is updated with no TTL in force; row 2 is the control.
UPDATE t_ttl_keep SET val = 'updated once' WHERE id = 1;
# Both rows visible before the deadline
SELECT id, val FROM t_ttl_keep ORDER BY id;
id	val
1	updated once
2	untouched
# Both expired -- the UPDATE did not extend row 1's life
SELECT id, val FROM t_ttl_keep ORDER BY id;
id	val
DROP TABLE t_ttl_keep;
#
# ============================================
# TEST 11: A TTL column of zero still clears an expiry
# ============================================
#
# Carrying a deadline forward is only for a table with no TTL of its own.  Where a
# TTL column exists it stays the row's answer, so setting it to zero on an UPDATE
# means this row no longer expires rather than keeping what it carried before.
CREATE TABLE t_ttl_clear (
id INT PRIMARY KEY,
val VARCHAR(32),
expires INT ENGINE_ATTRIBUTE='{"ttl": true}'
) ENGINE=TIDESDB;
INSERT INTO t_ttl_clear VALUES (1, 'cleared', 5), (2, 'left set', 5);
# Row 1 has its TTL column zeroed; row 2 keeps its 5s and is the control.
UPDATE t_ttl_clear SET expires = 0 WHERE id = 1;
# Row 1 survives with no expiry; row 2 expired on schedule
SELECT id, val FROM t_ttl_clear ORDER BY id;
id	val
1	cleared
DROP TABLE t_ttl_clear;
#
# ============================================
# TEST 12: The expiry survives an UPDATE driven by a scan
# ============================================
#
# TEST 10 updates by primary key, a point fetch.  An UPDATE whose WHERE is not on
# the key reads its rows through the scan iterator instead, which records each
# row's expiry as it passes.  Row 2 is also still a pending write of the open
# transaction when it is updated, so the expiry comes from the transaction's own
# buffered write rather than from the store.
CREATE TABLE t_ttl_scan (id INT PRIMARY KEY, val VARCHAR(32)) ENGINE=TIDESDB;
SET SESSION tidesdb_ttl = 5;
INSERT INTO t_ttl_scan VALUES (1, 'committed'), (3, 'control');
BEGIN;
INSERT INTO t_ttl_scan VALUES (2, 'pending');
SET SESSION tidesdb_ttl = 0;
UPDATE t_ttl_scan SET val = CONCAT(val, ' updated') WHERE val IN ('committed', 'pending');
COMMIT;
# All three visible before the deadline
SELECT id, val FROM t_ttl_scan ORDER BY id;
id	val
1	committed updated
2	pending updated
3	control
# All three expired -- neither scanned update extended its row
SELECT id, val FROM t_ttl_scan ORDER BY id;
id	val
DROP TABLE t_ttl_scan;
#
#
# Done.
